# ===========================================================================
#  API KEYS
# ===========================================================================
#  Copy this file to `.env` (setup.bat does that for you) and paste your keys
#  between the quotes. Nothing here is shared or uploaded anywhere — the file
#  stays on your machine.
# ===========================================================================

# OPTIONAL when llm_backend: local (Ollama / LM Studio).
# REQUIRED when llm_backend: openai — writes everything she says.
# Sign up at https://platform.openai.com/api-keys
OPENAI_API_KEY=""

# NVIDIA NIM free endpoints (OpenAI-compatible).
# Used when character_config points at https://integrate.api.nvidia.com/v1
# Create a key at https://build.nvidia.com/settings/api-keys
NVIDIA_API_KEY=""

# OPTIONAL with local Whisper (asr_backend: local) + dummy tool agent.
# Still required if you set asr_backend: groq, or AGENT_BACKEND = "real"
# in server/config.py. FREE: https://console.groq.com/keys
GROQ_API_KEY=""

# OPTIONAL — only if you set `tts_backend: fish` in character_config*.yaml.
# Not needed for Edge TTS (`tts_backend: edge`) or local GPT-SoVITS.
# Sign up at https://fish.audio
FISH_API_KEY=""

# Optional character override (also set by start_luna_*.bat):
# RIKO_CHARACTER=riko
# RIKO_VOICE_SOURCE=mic

# ===========================================================================
#  Fact brain — Amy skills + persona, identity stays Luna (see HALMINI.md)
# ===========================================================================
# HALMINI_SHARE=D:\HalMini-share
# HALMINI_ENABLED=1
# HALMINI_ROOT=D:\HalMini-share\Amy
# HALMINI_DB=data/luna_amy.db
# HALMINI_SELF_NAME=Luna
# HALMINI_PERSONA=amy
# NEWCHAMP_ENABLED=1
# NEWCHAMP_DB=data/newchamp_memories.db
# NEWCHAMP_IMPORT_DB=D:\HalMini-share\new-champ\data\companion.db
