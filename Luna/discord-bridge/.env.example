DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=
# Optional: faster slash-command updates
# DISCORD_GUILD_ID=

# Your Discord user id(s) — comma-separated. Tagged as role=owner / YOU.
# Right-click yourself in Discord → Copy User ID (Developer Mode on).
# Solonaras (website mic = same person):
DISCORD_OWNER_USER_IDS=1414944231222411378

RIKO_HTTP_URL=http://127.0.0.1:8100

# Listen in VC (Whisper via project .venv). Set 0 to disable.
LUNA_DISCORD_LISTEN=1
WHISPER_MODEL=base
# LUNA_SPEECH_END_SILENCE_MS=1400

# Wake word — STTs everyone; replies when Luna (or a fuzzy STT near-miss) appears anywhere.
LUNA_WAKE_REQUIRED=1
LUNA_WAKE_WORDS=luna,hey luna,hi luna,okay luna,ok luna,yo luna,loona,lunah,lunaa,lunna,louna,lina,luma
LUNA_WAKE_DENY=lunar,lunch,lung,lunge,alone,lonely,london,lounge,lunae
# 0 = must say Luna every time (recommended). >0 = silent follow-up window in ms.
LUNA_WAKE_FOLLOWUP_MS=0

# Music (system yt-dlp + ffmpeg on PATH)
# YTDLP_BINARY=yt-dlp
# FFMPEG_BINARY=ffmpeg
